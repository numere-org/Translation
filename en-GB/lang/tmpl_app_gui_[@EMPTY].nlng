#***************************************************************************************************
 * WINDOW LAYOUT: %%1%%
 * =================================================================================================
 * Generated: %%2%% *#

## Enumerate the window items
declare enum -> {nABOUT = 0}, sAPPNAME="%%1%%", sAPPVERSION="0.0.1"

##! \layout appmain
##!
##! Defines the layout for the "%%1%%" app.
layout -title=sAPPNAME size={1024,768} statustext="Welcome at " + sAPPNAME + " v" + sAPPVERSION
	## Create a "File" menu
	group -style=menu label="File"
		menuitem "Close" -set onclick=evt_close()
	endgroup
	
	## Create an "Help" menu
	group -style=menu label="Help"
		menuitem "About " + sAPPNAME -set id=nABOUT onclick=$this~handleEvent()
	endgroup
	
	##~ Add further commands for your desired app
	|
endlayout

